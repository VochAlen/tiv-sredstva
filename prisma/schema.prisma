// GSE Control - Prisma schema (za Demo Mode)
// Production koristi Supabase (vidi supabase/migrations/)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id         String   @id @default(cuid())
  cardId     String   @unique
  name       String
  department String   @default("Ramp")
  role       String   @default("Operator")
  active     Boolean  @default(true)
  pin        String? // 4-digit PIN for no-login worker identification
  idCardQr   String? // QR kod na ID kartici
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments    Assignment[]
  damages        DamageReport[]
  qualifications EquipmentQualification[]
}

model Equipment {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String
  serialNumber String?
  location     String   @default("Stand A1")
  status       String   @default("AVAILABLE")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ADR.OPS.C.007 - Vehicle Fitness Certificate
  fitnessStatus       String? // FIT | UNFIT | CONDITIONAL (auto-calculated)
  fitnessCalculatedAt DateTime?
  fitnessReason       String? // why it's unfit/conditional

  // Vehicle Operating Manual (Part-145 §65)
  manualUrl String? // direct link to PDF manual

  // Access Control - admin može ograničiti ko može zadužiti sredstvo
  restrictedAccess Boolean @default(false)

  // Fuel / Charging state
  fuelType         String? // DIESEL | PETROL | ELECTRIC | HYBRID | LPG
  fuelLevel        Float? // current level: % for electric, liters for fuel
  fuelCapacity     Float? // max capacity (liters or kWh)
  lowFuelThreshold Float   @default(20) // alert below this %

  // Periodic inspections (IATA AHM 1130)
  lastInspectionDate       DateTime?
  nextInspectionDate       DateTime?
  inspectionIntervalMonths Int       @default(12)

  // Operating hours (EASA Part-M continued airworthiness)
  totalOperatingHours      Float @default(0)
  maintenanceIntervalHours Float @default(500)
  lastMaintenanceHours     Float @default(0)

  // Kilometrage tracking
  totalKm               Float @default(0)
  maintenanceIntervalKm Float @default(10000)
  lastMaintenanceKm     Float @default(0)

  // Lifecycle info
  manufacturer       String?
  modelYear          Int?
  purchaseDate       DateTime?
  warrantyExpiry     DateTime?
  registrationNumber String?

  assignments     Assignment[]
  damages         DamageReport[]
  maintenanceLogs MaintenanceLog[]
  photos          EquipmentPhoto[]

  @@index([status])
  @@index([type])
  @@index([nextInspectionDate])
}

model Assignment {
  id             String  @id @default(cuid())
  equipmentId    String
  equipmentCode  String
  equipmentName  String
  employeeId     String?
  employeeCardId String
  employeeName   String

  action           String
  inspectionResult String
  inspectionNotes  String?
  checklistJson    String

  shift          String?
  damageReportId String?

  timestamp DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])

  @@index([equipmentId])
  @@index([employeeCardId])
  @@index([action])
  @@index([timestamp])
}

model DamageReport {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  reportedByCardId String
  reportedByName   String
  employeeId       String?

  severity    String    @default("MINOR")
  description String
  status      String    @default("OPEN")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Root cause analysis (EASA Part-145)
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  insuranceClaimRef String?
  estimatedCost     Float?

  equipment Equipment        @relation(fields: [equipmentId], references: [id])
  employee  Employee?        @relation(fields: [employeeId], references: [id])
  photos    EquipmentPhoto[]

  @@index([status])
  @@index([equipmentId])
}

model MaintenanceLog {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  maintenanceType         String // PREVENTIVE | CORRECTIVE | INSPECTION | OVERHAUL
  description             String
  performedBy             String?
  performedByCardId       String?
  cost                    Float?
  durationHours           Float?
  operatingHoursAtService Float?

  certificateNumber String?
  partsReplaced     String?
  nextDueHours      Float?
  nextDueDate       DateTime?

  status String @default("COMPLETED")

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([maintenanceType])
  @@index([performedAt])
}

model EquipmentPhoto {
  id             String   @id @default(cuid())
  damageReportId String?
  equipmentId    String?
  photoData      String // base64 encoded
  photoType      String   @default("image/jpeg")
  caption        String?
  takenByCardId  String?
  takenByName    String?
  takenAt        DateTime @default(now())

  damageReport DamageReport? @relation(fields: [damageReportId], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])

  @@index([damageReportId])
  @@index([equipmentId])
}

model EquipmentQualification {
  id                 String    @id @default(cuid())
  employeeId         String
  employeeCardId     String
  employeeName       String
  equipmentType      String
  qualificationLevel String    @default("OPERATOR")
  trainedAt          DateTime?
  validUntil         DateTime?
  certifiedBy        String?
  certificateNumber  String?
  createdAt          DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, equipmentType])
  @@index([employeeId])
  @@index([equipmentType])
}

model WebhookSetting {
  id                       String   @id @default(cuid())
  name                     String
  webhookUrl               String
  webhookType              String   @default("SLACK")
  enabled                  Boolean  @default(true)
  triggerCriticalDamage    Boolean  @default(true)
  triggerDamageResolved    Boolean  @default(false)
  triggerOutOfService      Boolean  @default(true)
  triggerInspectionOverdue Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  id                              Int      @id @default(1)
  airportName                     String   @default("Aerodrom")
  airportCode                     String   @default("XXX")
  timezone                        String   @default("Europe/Podgorica")
  language                        String   @default("hr")
  requirePhotoForDamage           Boolean  @default(false)
  requireQualificationForCheckout Boolean  @default(true)
  enableEmailNotifications        Boolean  @default(true)
  enableWebhookNotifications      Boolean  @default(false)
  inspectionReminderDays          Int      @default(30)
  updatedAt                       DateTime @updatedAt
}

// =====================================================
// EASA Part-145 §50 - Life-limited components
// =====================================================
model EquipmentComponent {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String

  componentName String
  componentType String
  serialNumber  String?
  manufacturer  String?

  installedAt     DateTime?
  installedHours  Float     @default(0)
  lifeLimitHours  Float?
  lifeLimitCycles Float?
  currentHours    Float     @default(0)
  currentCycles   Float     @default(0)

  status String @default("ACTIVE")

  replacedAt      DateTime?
  replacedBy      String?
  replacementCost Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([status])
  @@index([componentType])
}

// =====================================================
// EASA Part-145 §71 - Service Bulletins
// =====================================================
model ServiceBulletin {
  id             String @id @default(cuid())
  bulletinNumber String @unique
  title          String
  manufacturer   String

  equipmentType String?
  serialRange   String?

  description    String
  requiredAction String
  partsRequired  String?
  estimatedHours Float?

  priority           String    @default("MEDIUM")
  complianceDeadline DateTime?
  status             String    @default("OPEN")

  issuedAt        DateTime
  completedAt     DateTime?
  completedBy     String?
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([manufacturer])
  @@index([priority])
}

// =====================================================
// EASA Part-M §39 - Airworthiness Directives
// =====================================================
model AirworthinessDirective {
  id       String @id @default(cuid())
  adNumber String @unique
  title    String

  equipmentType String?

  description      String
  requiredAction   String
  complianceMethod String?

  priority               String    @default("HIGH")
  effectiveDate          DateTime
  complianceDeadline     DateTime?
  recurring              Boolean   @default(false)
  recurringIntervalHours Float?

  status String @default("OPEN")

  compliedAt      DateTime?
  compliedBy      String?
  complianceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
}

// =====================================================
// IATA AHM 340 - Shift Handovers
// =====================================================
model ShiftHandover {
  id        String   @id @default(cuid())
  shiftDate DateTime
  shiftType String

  outgoingCardId    String
  outgoingName      String
  outgoingSignature String?

  incomingCardId    String
  incomingName      String
  incomingSignature String?

  assignedEquipmentCount Int     @default(0)
  openDamagesCount       Int     @default(0)
  notes                  String?

  status String @default("COMPLETED")

  handoverAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([shiftDate])
  @@index([outgoingCardId])
  @@index([incomingCardId])
}

// =====================================================
// ADR.OPS.C.007 - Maintenance Schedule (auto-generation)
// =====================================================
model MaintenanceSchedule {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  maintenanceType String // PREVENTIVE | PERIODIC | ANNUAL | SCHEDULED
  title           String
  description     String?

  // Trigger criteria
  triggerHours          Float? // at what operating hours
  triggerKm             Float? // at what kilometerage
  triggerDate           DateTime? // or at what date
  triggerInterval       Float? // recurring interval (hours)
  triggerIntervalKm     Float? // recurring interval (km)
  triggerIntervalMonths Int? // recurring interval (months)

  // Status
  status   String @default("SCHEDULED") // SCHEDULED | DUE | IN_PROGRESS | COMPLETED | OVERDUE
  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL

  // Completion
  completedAt     DateTime?
  completedBy     String?
  completionNotes String?
  actualHours     Float?

  // Auto-generated
  autoGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([status])
  @@index([priority])
}

// =====================================================
// ADR.OPS.C.007 - Daily Inspection Record
// =====================================================
model DailyInspection {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  // Inspector
  inspectorCardId String
  inspectorName   String

  // Inspection date
  inspectionDate DateTime @default(now())
  shift          String // MORNING | AFTERNOON | NIGHT

  // Checklist (JSON: [{ id, label, passed }])
  checklistJson String

  // Result
  result String // FIT | UNFIT | CONDITIONAL
  notes  String?

  // Issues found
  issuesFound Int     @default(0)
  issuesJson  String? // JSON array of issues

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([inspectionDate])
  @@index([result])
}

// =====================================================
// EASA Part-145 §65 - Vehicle Operating Manuals
// =====================================================
model EquipmentManual {
  id            String  @id @default(cuid())
  equipmentId   String? // null = generic manual for equipmentType
  equipmentCode String? // denormalized for display
  equipmentName String? // denormalized
  equipmentType String // TOW_TRACTOR, GPU, BELT_LOADER, etc.

  title      String // npr. "Goldhofer AST-2 Operating Manual"
  manualUrl  String // URL to PDF (Supabase Storage or external)
  manualType String  @default("OPERATING") // OPERATING | MAINTENANCE | SAFETY | PARTS
  language   String  @default("hr") // hr | en | de | etc.
  fileSize   Int? // bytes (optional)
  uploadedBy String?
  version    String? // npr. "v2.1"
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([equipmentType])
  @@index([manualType])
}

// =====================================================
// Equipment Access Control - ko može zadužiti koje sredstvo
// =====================================================
model EquipmentAccess {
  id             String   @id @default(cuid())
  equipmentId    String
  equipmentCode  String
  employeeCardId String
  employeeName   String
  grantedBy      String? // ko je dao dozvolu
  createdAt      DateTime @default(now())

  @@unique([equipmentId, employeeCardId])
  @@index([equipmentId])
  @@index([employeeCardId])
}

// =====================================================
// EASA Part-145.A.50 - Certificate of Release to Service
// =====================================================
model CertificateOfRelease {
  id            String @id @default(cuid())
  crsNumber     String @unique // npr. "CRS-2026-001"
  equipmentId   String
  equipmentCode String
  equipmentName String

  // Povezanost sa damage report-om (ako je CRS nakon popravke)
  damageReportId String?

  // Povezanost sa maintenance log-om (ako je CRS nakon održavanja)
  maintenanceLogId String?

  // Detalji popravke/održavanja
  workDescription String // šta je urađeno
  workOrderNumber String? // radni nalog

  // Certifying staff (ko potpisuje CRS)
  certifierCardId    String // broj kartice ovlaštene osobe
  certifierName      String // ime ovlaštene osobe
  certifierRole      String  @default("CERTIFYING_STAFF") // CERTIFYING_STAFF | ENGINEER | ADMIN
  certifierSignature String? // digitalni potpis (opcionalno)

  // Status
  status String @default("VALID") // VALID | REVOKED | SUPERSEDED

  // Datumi
  releaseDate DateTime  @default(now())
  validUntil  DateTime? // ako je ograničena valjanost

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([crsNumber])
  @@index([status])
  @@index([releaseDate])
}

// =====================================================
// Spare Parts Inventory — rezervni dijelovi u magacinu
// =====================================================
model SparePart {
  id           String  @id @default(cuid())
  partNumber   String  @unique // npr. "OEM-GH-12345"
  name         String // npr. "Prednja guma 11x22.5"
  category     String // TIRE | BRAKE | HYDRAULIC | ELECTRICAL | FILTER | ENGINE | OTHER
  manufacturer String?
  description  String?

  // Stock
  quantity    Int     @default(0)
  minQuantity Int     @default(1) // alert kada padne ispod
  unit        String  @default("kom") // kom | litra | metar | kg
  location    String? // npr. "Polica A-3"

  // Price (zadnja nabavna cijena)
  unitPrice Float? // cijena bez PDV
  vatRate   Float  @default(21) // PDV u %

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([name])
}

// =====================================================
// Part Purchases — nabavka rezervnih dijelova
// =====================================================
model PartPurchase {
  id         String  @id @default(cuid())
  partId     String?
  partNumber String // denormalized
  partName   String // denormalized

  // Purchase details
  orderNumber     String? // broj porudžbe
  supplier        String // naziv firme
  supplierAddress String?
  invoiceNumber   String? // broj računa
  invoiceDate     DateTime?

  // Quantities & pricing
  quantity     Int
  unitPriceNet Float // cijena po jedinici bez PDV
  vatRate      Float @default(21) // PDV %
  vatAmount    Float @default(0) // iznos PDV
  totalNet     Float // ukupno bez PDV
  totalGross   Float // ukupno sa PDV

  // Payment
  paymentMethod String? // CARD | CASH | INVOICE | TRANSFER
  paid          Boolean   @default(false)
  paidDate      DateTime?

  notes       String?
  purchasedBy String?
  createdAt   DateTime @default(now())

  @@index([partId])
  @@index([supplier])
  @@index([invoiceDate])
}

// =====================================================
// Part Consumption — utrošak rezervnih dijelova
// =====================================================
model PartConsumption {
  id         String  @id @default(cuid())
  partId     String?
  partNumber String // denormalized
  partName   String // denormalized

  equipmentId      String?
  equipmentCode    String? // na kojem vozilu je korišteno
  maintenanceLogId String? // povezano sa maintenance log

  quantity     Int    @default(1)
  unitPriceNet Float? // cijena bez PDV u trenutku utroška
  totalCost    Float? // ukupni trošak

  consumedBy String? // ko je uzeo dio
  consumedAt DateTime @default(now())
  notes      String?

  @@index([partId])
  @@index([equipmentId])
  @@index([consumedAt])
}

// =====================================================
// ADR.OPS.B.005 - Incident/Accident Reporting (SMS)
// =====================================================
model Incident {
  id             String @id @default(cuid())
  incidentNumber String @unique // npr. "INC-2026-001"

  // Tip incidenta
  incidentType String // GSE_AIRCRAFT | GSE_PERSON | GSE_INFRASTRUCTURE | GSE_GSE | FOD | SPILL | OTHER
  severity     String  @default("MINOR") // MINOR | MAJOR | SERIOUS | ACCIDENT
  smorRequired Boolean @default(false) // Safety Mandatory Occurrence Reporting

  // Lokacija i vrijeme
  location   String // npr. "Stand A1", "Taxiway B", "Apron 3"
  zone       String? // APRON | TAXIWAY | RUNWAY | SERVICE_ROAD | TERMINAL
  occurredAt DateTime

  // Uslovi
  weather          String? // SUNNY | CLOUDY | RAIN | FOG | SNOW | STORM
  visibility       String? // GOOD | MODERATE | POOR | LVP
  surfaceCondition String? // DRY | WET | ICY | SNOW

  // GSE uključeno
  equipmentId   String?
  equipmentCode String?
  equipmentName String?

  // Osobe uključene
  operatorCardId String?
  operatorName   String?

  // Opis
  description     String // šta se desilo
  immediateAction String? // šta je odmah urađeno

  // Root cause analysis
  rootCause           String?
  contributingFactors String?

  // Corrective actions
  correctiveActions String? // šta je urađeno da se ne ponovi
  preventiveActions String? // šta će se urađiti ubuduće

  // Status
  status           String   @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | CLOSED
  reportedBy       String
  reportedByCardId String?
  reportedAt       DateTime @default(now())

  // Ozljede / šteta
  injuriesReported Boolean @default(false)
  injuryDetails    String?
  damageEstimate   Float? // procijenjena šteta u EUR

  // Notifikacije
  authorityNotified String? // ko je obaviješten (CAA, airport authority, police)
  notificationDate  DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incidentType])
  @@index([severity])
  @@index([status])
  @@index([occurredAt])
  @@index([equipmentId])
}

// =====================================================
// ADR.OPS.C.005 - Driver Authorization za Movement Area
// =====================================================
model DriverAuthorization {
  id             String @id @default(cuid())
  employeeCardId String @unique
  employeeName   String

  // Kategorije dozvole
  category1 Boolean @default(false) // Airside (apron, service roads)
  category2 Boolean @default(false) // Maneuvering area (taxiway)
  category3 Boolean @default(false) // Runway (samo specijalno ovlašćeno)

  // Vozačka dozvola za airside
  licenseNumber String? // broj airside driving permit
  issuedAt      DateTime?
  validUntil    DateTime? // datum isteka dozvole
  issuedBy      String? // ko je izdao

  // Obuka
  trainingCompleted Boolean   @default(false)
  trainingDate      DateTime?
  trainingExpiry    DateTime? // datum isteka obuke

  // Status
  active        Boolean   @default(true)
  suspendedAt   DateTime?
  suspendReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCardId])
  @@index([validUntil])
  @@index([trainingExpiry])
}

// =====================================================
// Fuel / Charging Management — točenje goriva i punjenje
// =====================================================
model FuelLog {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  fuelType String // DIESEL | PETROL | ELECTRIC | HYBRID | LPG
  amount   Float // liters for fuel, kWh for electric
  unit     String @default("L") // L | kWh | kg

  // Stanje pre i posle
  levelBefore Float? // % or liters before refueling
  levelAfter  Float? // % or liters after refueling

  // Pump / charger info
  pumpStation String? // npr. "Pump 1", "Charger A"
  costPerUnit Float? // cijena po litri/kWh
  totalCost   Float? // ukupni trošak

  // Ko je točio
  operatorCardId String
  operatorName   String

  // Vrijeme
  fueledAt DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([fueledAt])
  @@index([fuelType])
}

// =====================================================
// GSE Parking Management — AHM 1115
// =====================================================
model ParkingConfirmation {
  id            String @id @default(cuid())
  equipmentId   String
  equipmentCode String
  equipmentName String

  // Ko je parkirao
  operatorCardId String
  operatorName   String

  // Potvrde (AHM 1115 checklist)
  parkedAtDesignatedSpot Boolean @default(false)
  handbrakeEngaged       Boolean @default(false)
  ignitionOff            Boolean @default(false)
  lightsOff              Boolean @default(false)
  keyRemoved             Boolean @default(false)
  chocksPlaced           Boolean @default(false) // za avionsku opremu

  // Lokacija
  parkingLocation String? // npr. "Stand A1 - Position 3"
  photoUrl        String? // foto potvrda parkinga (base64 or URL)

  // Povezano sa check-in
  assignmentId String?

  // Status
  allConfirmed   Boolean @default(false) // sve potvrde da
  issuesReported String? // ako nešto nije potvrđeno

  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([equipmentId])
  @@index([confirmedAt])
  @@index([operatorCardId])
}

// ============================================================================
// DE-ICING / ANTI-ICING (ICAO Annex 3, AEA Recommendations, ISO 11076)
// ============================================================================

// Inventar tečnosti za zaleđivanje (Type I/II/III/IV)
model DeicingFluid {
  id              String    @id @default(cuid())
  fluidType       String // TYPE_I | TYPE_II | TYPE_III | TYPE_IV
  brandName       String // npr. "Kilfrost ABC-S Plus", "Clariant Safewing MP II"
  manufacturer    String?
  batchNumber     String    @unique // batch lot
  quantityLiters  Float // količina u litrima
  unitPrice       Float? // cijena po litru (EUR)
  concentration   String? // npr. "50/50", "75/25", "100/0" (Type II/IV)
  expiryDate      DateTime? // rok upotrebe
  receivedAt      DateTime  @default(now())
  storageLocation String? // npr. "Skladište B - Polica 3"
  safetyDataSheet String? // SDS link / path
  notes           String?

  // Status
  isExpired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fluidType])
  @@index([batchNumber])
  @@index([expiryDate])
}

// Operacija de-icing / anti-icing na avionu
model DeicingRecord {
  id String @id @default(cuid())

  // Let / avion
  flightNumber  String? // npr. "AY1234"
  aircraftReg   String? // npr. "OH-LXA"
  aircraftType  String? // npr. "A320", "B737-800"
  standPosition String? // npr. "Stand 5"

  // Operacija
  operationType    String // DEICING | ANTI_ICING | BOTH
  fluidType        String // TYPE_I | TYPE_II | TYPE_III | TYPE_IV
  concentration    String? // 50/50 | 75/25 | 100/0 (Type II/IV)
  fluidBatchNumber String? // batch tečnosti koja je korištena
  fluidUsedLiters  Float // količina u litrima
  applicationStart DateTime // početak aplikacije
  applicationEnd   DateTime? // kraj aplikacije
  durationMinutes  Int? // trajanje (auto-izračunato)

  // Vremenski uslovi (ICAO Annex 3)
  oat                    Float // Outside Air Temperature (°C)
  precipitation          String? // NONE | SNOW | LIGHT_FREEZING_RAIN | FREEZING_DRIZZLE | RAIN_COLD_SOAK | FREEZING_FOG | COLD_SOAK
  precipitationIntensity String? // LIGHT | MODERATE | HEAVY
  windSpeed              Float? // m/s
  windDirection          Int? // stepni
  dewPoint               Float? // °C
  visibility             Float? // m

  // HOT (Holdover Time) — izračunato
  holdoverTimeMinutes Int? // minuta (iz ISO 11076 tabele)
  hotTableRef         String? // npr. "Type II 50/50, Snow, -3°C"

  // Vozilo i osoblje
  equipmentCode  String? // GSE-DEI-001
  operatorName   String? // ko je operisao
  operatorCardId String? // broj kartice
  shift          String? // npr. "Morning", "Evening", "Night"

  // Status aviona nakon operacije
  inspectionResult      String? // CLEAN | CONTAMINATED | PARTIAL
  postCheckBy           String? // ko je uradio post-check
  reapplicationRequired Boolean @default(false)

  // Napomene
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStart])
  @@index([flightNumber])
  @@index([aircraftReg])
  @@index([equipmentCode])
  @@index([fluidType])
}

// Disposal records — environmental compliance (ISO 14001)
model DeicingFluidDisposal {
  id           String   @id @default(cuid())
  disposalDate DateTime @default(now())

  fluidType      String // TYPE_I | TYPE_II | TYPE_III | TYPE_IV
  batchNumber    String?
  quantityLiters Float // količina odbačena
  disposalMethod String // RECYCLED | INCINERATED | TREATMENT_PLANT | COLLECTED_BY_VENDOR
  vendorName     String? // ako je predato trećoj strani
  vendorLicense  String? // dozvolta vendora
  manifestNumber String? // prateći dokument

  // Cijena disposal-a
  disposalCost Float? // EUR

  location String? // gde je odbačeno
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disposalDate])
  @@index([fluidType])
  @@index([batchNumber])
}

// ============================================================================
// AERODROME DAILY INSPECTION (ADR.OPS.B.005 + ICAO Annex 14)
// ============================================================================

// Dnevna inspekcija aerodroma (runway, taxiway, apron, movement area)
model AerodromeInspection {
  id String @id @default(cuid())

  // Tip inspekcije
  inspectionType    String // RUNWAY | TAXIWAY | APRON | MOVEMENT_AREA_JOINT
  inspectionDate    DateTime // datum i vrijeme inspekcije
  performedBy       String // ime inspektora
  performedByCardId String? // broj kartice
  shift             String? // Morning | Evening | Night

  // Pozicija inspekcije (ako je runway/taxiway)
  runwayCode  String? // npr. "14/32", "08/26"
  taxiwayCode String? // npr. "A", "B1", "TWY-A"
  apronArea   String? // npr. "Apron 1", "Stand A1-A5"

  // Vremenski uslovi
  weatherConditions String? // npr. "Clear, OAT 5°C, wind 280/5kt"
  visibility        Float? // metars
  runwayCondition   String? // DRY | WET | DAMP | SNOW | ICE | SLUSH | STANDING_WATER

  // Rezultat
  status        String // COMPLETED | WITH_FINDINGS | CRITICAL | ABORTED
  findingsCount Int    @default(0)
  criticalCount Int    @default(0)

  // Provjere (boolean — applicable/ok/not_ok/not_applicable)
  // Runway provjere
  runwaySurface           String? // OK | NOT_OK | N/A
  runwayMarkings          String? // OK | NOT_OK | N/A
  runwayLights            String? // OK | NOT_OK | N/A
  papiLights              String? // OK | NOT_OK | N/A
  windDirectionIndicators String? // OK | NOT_OK | N/A
  // Taxiway provjere
  taxiwaySurface          String? // OK | NOT_OK | N/A
  taxiwaySigns            String? // OK | NOT_OK | N/A
  taxiwayLights           String? // OK | NOT_OK | N/A
  // Apron provjere
  gseParking              String? // OK | NOT_OK | N/A
  fodCheck                String? // OK | NOT_OK | N/A
  markings                String? // OK | NOT_OK | N/A
  fuelingArea             String? // OK | NOT_OK | N/A
  // Movement area
  drainageSystem          String? // OK | NOT_OK | N/A
  perimeterFence          String? // OK | NOT_OK | N/A
  wildlifeActivity        String? // OK | NOT_OK | N/A

  // Napomene
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings InspectionFinding[]

  @@index([inspectionDate])
  @@index([inspectionType])
  @@index([status])
  @@index([performedBy])
}

// Inspekcijski nalazi (findings) sa fotografijama i koordinatama
model InspectionFinding {
  id           String              @id @default(cuid())
  inspectionId String // veza na DailyInspection
  inspection   AerodromeInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Tip i opis
  category    String // FOD | PAVEMENT_DAMAGE | MARKINGS | LIGHTING | WILDLIFE | DRAINAGE | GSE_PARKING | SIGNAGE | OTHER
  severity    String // LOW | MEDIUM | HIGH | CRITICAL
  description String // detaljan opis nalaza
  location    String? // opisna lokacija npr. "RWY 14, 200m from threshold"

  // Koordinate
  latitude  Float?
  longitude Float?

  // Foto dokaz (base64 ili URL)
  photoUrl String?

  // Akcija
  actionRequired String? // opis potrebne akcije
  actionTaken    String? // opis poduzete akcije
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | DEFERRED
  resolvedAt     DateTime?
  resolvedBy     String?

  // NOTAM (ako je kreiran)
  notamGenerated Boolean @default(false)
  notamNumber    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
  @@index([category])
  @@index([severity])
  @@index([status])
}

// NOTAM (Notice to Airmen) — generisani na osnovu findings
model Notam {
  id             String  @id @default(cuid())
  notamNumber    String  @unique // npr. "A1234/26"
  series         String // A | B | C | D | E | F | G | S | T
  qualifier      String // NOTAMN (new) | NOTAMR (replace) | NOTAMC (cancel)
  refNotamNumber String? // za replace/cancel

  // Sadržaj
  fir         String  @default("LYBA") // Flight Information Region (Beograd)
  aerodrome   String  @default("LYTV") // ICAO kod aerodroma (Tivat)
  subject     String // npr. "RWY", "TWY", "APRON", "AD"
  condition   String // npr. "CLOSED", "WIP", "FOD", "POOR SURFACE"
  purpose     String // N (OBSTACLE) | B (bez uslova) | O (ostalo) | M (military) | K (checklist)
  scope       String // A (aerodrome) | E (en-route) | W (navigation warning) | K (checklist)
  traffic     String // IFR | VFR | IV (oba)
  lowerLimit  Int?
  upperLimit  Int?
  coordinates String?
  radius      Float?

  // Tekst
  text                    String // NOTAM text (Item E)
  createdFromFindingId    String? // veza na finding
  createdFromInspectionId String? // veza na inspection

  // Status
  status    String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  validFrom DateTime @default(now())
  validTo   DateTime

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notamNumber])
  @@index([aerodrome])
  @@index([status])
  @@index([validTo])
}

// ============================================================================
// SMS — Safety Management System (ICAO Annex 19, EASA M.GEN.205)
// ============================================================================

// Hazard Identification Log — proaktivno prijavljivanje opasnosti
model Hazard {
  id               String   @id @default(cuid())
  hazardId         String   @unique // npr. "HZ-2026-001"
  title            String // kratak naslov
  description      String // detaljan opis
  category         String // OPERATIONAL | TECHNICAL | ENVIRONMENTAL | HUMAN | ORGANIZATIONAL | EXTERNAL
  source           String // INSPECTION | INCIDENT | AUDIT | EMPLOYEE | SAFETY_CULTURE_SURVEY | OTHER
  location         String? // gde je hazard uočen
  reportedBy       String // prijavitelj
  reportedByCardId String?
  reportedAt       DateTime @default(now())

  // Početna procjena rizika (prije mitigejšna)
  initialProbability Int // 1-5
  initialSeverity    Int // 1-5
  initialRiskLevel   String // LOW | MEDIUM | HIGH | CRITICAL (auto-izračunato)

  // Trenutni status
  status     String    @default("OPEN") // OPEN | ASSESSED | MITIGATED | CLOSED | MONITORED
  assignedTo String? // ko je zadužen
  dueDate    DateTime?

  // Mitigejšn
  mitigation          String? // opis preduzetih mjera
  residualProbability Int? // nakon mitigejšna
  residualSeverity    Int?
  residualRiskLevel   String? // LOW | MEDIUM | HIGH | CRITICAL

  // ALARP justification
  alarpJustification String? // zašto je rizik ALARP (As Low As Reasonably Practicable)
  alarpReviewedAt    DateTime?
  alarpReviewedBy    String?

  // Veza na Safety Action Plan
  actionPlanId String?

  closedAt DateTime?
  closedBy String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hazardId])
  @@index([category])
  @@index([status])
  @@index([initialRiskLevel])
  @@index([reportedAt])
}

// SPI — Safety Performance Indicators
model SPI {
  id          String  @id @default(cuid())
  spiId       String  @unique // npr. "SPI-001"
  name        String // npr. "Broj GSE incidenata po 10.000 pokreta"
  description String?
  category    String // OUTPUT | PROCESS | LEADING | LAGGING
  unit        String // npr. "incidents", "%", "hours"
  frequency   String // MONTHLY | QUARTERLY | ANNUALLY

  // Tolerable limit (gornja granica)
  targetValue    Float // ciljana vrijednost (npr. 0.5)
  alertLevel     Float // nivo upozorenja (npr. 1.0)
  tolerableLimit Float // maksimalno tolerisano (npr. 2.0)

  // Trenutna vrijednost
  currentValue  Float?
  currentPeriod String? // npr. "2026-08"
  trend         String? // IMPROVING | STABLE | WORSENING

  // Status
  status      String   @default("GREEN") // GREEN | AMBER | RED
  lastUpdated DateTime @default(now())

  // Veza na SPT
  sptId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spiId])
  @@index([category])
  @@index([status])
}

// SPT — Safety Performance Targets
model SPT {
  id            String  @id @default(cuid())
  sptId         String  @unique // npr. "SPT-001"
  name          String // npr. "Smanjiti GSE incidente za 20% YoY"
  description   String?
  category      String // SAFETY | OPERATIONAL | COMPLIANCE
  baselineValue Float // početna vrijednost
  targetValue   Float // ciljana vrijednost
  currentValue  Float?
  unit          String

  // Vremenski okvir
  startDate       DateTime
  targetDate      DateTime
  status          String   @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK | ACHIEVED | MISSED
  progressPercent Float    @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sptId])
  @@index([status])
  @@index([targetDate])
}

// Safety Action Plan — akcije sa rokovima i odgovornima
model SafetyAction {
  id          String @id @default(cuid())
  actionId    String @unique // npr. "SAP-2026-001"
  title       String
  description String
  category    String // CORRECTIVE | PREVENTIVE | MITIGATION | IMPROVEMENT
  priority    String // LOW | MEDIUM | HIGH | CRITICAL

  // Veza
  hazardId String? // ako proizilazi iz hazard-a
  spiId    String? // ako je vezano za SPI
  sptId    String? // ako je vezano za SPT

  // Realizacija
  assignedTo       String // odgovorna osoba
  assignedToCardId String?
  dueDate          DateTime
  completedAt      DateTime?
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | OVERDUE | CANCELLED

  // Trošak
  estimatedCost Float?
  actualCost    Float?

  // Napomene
  progressNotes      String?
  verificationResult String? // kako je verifikovano da je akcija efikasna

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actionId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedTo])
}

// ============================================================================
// AUDIT & COMPLIANCE MONITORING (ADR.OPS.D.005 + EASA Part-145.A.65)
// ============================================================================

// Audit Program — godišnji plan internih audita
model AuditProgram {
  id            String  @id @default(cuid())
  programId     String  @unique // npr. "AP-2026-001"
  title         String // npr. "Internal Audit GSE Operations Q1 2026"
  auditType     String // INTERNAL | EXTERNAL | REGULATORY | SUPPLIER | PROCESS | SYSTEM
  auditScope    String // opseg (npr. "GSE maintenance, QR check-out, fuel operations")
  auditStandard String? // npr. "EASA Part-145", "ADR.OPS.D.005", "ISO 9001"

  // Period
  plannedYear    Int // npr. 2026
  plannedQuarter Int? // 1-4
  plannedDate    DateTime?
  actualDate     DateTime?
  completedAt    DateTime?

  // Osobe
  leadAuditor       String // glavni auditor
  leadAuditorCardId String?
  auditees          String? // ko se audituje (npr. "Maintenance Dept, Ramp Ops")

  // Status
  status   String @default("PLANNED") // PLANNED | SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | OVERDUE
  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL

  // Rezultat (popunjava se nakon audita)
  findingsCount Int     @default(0)
  majorFindings Int     @default(0)
  minorFindings Int     @default(0)
  observations  Int     @default(0)
  overallResult String? // CONFORMANT | NON_CONFORMANT | CONDITIONAL

  // Napomene
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits Audit[]

  @@index([programId])
  @@index([plannedYear])
  @@index([status])
  @@index([auditType])
}

// Audit — pojedinačna realizacija audita
model Audit {
  id        String        @id @default(cuid())
  auditId   String        @unique // npr. "AUD-2026-001"
  programId String? // veza na AuditProgram (ako postoji)
  program   AuditProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  title         String
  auditType     String // INTERNAL | EXTERNAL | REGULATORY | SUPPLIER | PROCESS | SYSTEM
  auditScope    String
  auditStandard String?
  description   String?

  // Datumi
  scheduledDate DateTime
  startDate     DateTime?
  endDate       DateTime?
  reportDate    DateTime?

  // Auditori
  leadAuditor       String
  leadAuditorCardId String?
  auditTeam         String? // ostali članovi tima

  // Audited
  auditeeOrganization String? // npr. "Maintenance Department"
  auditeeContact      String? // kontakt osoba
  auditeeAreas        String? // oblasti koje su auditovane

  // Status
  status String @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED

  // Rezultat
  overallResult   String? // CONFORMANT | NON_CONFORMANT | CONDITIONAL
  summary         String? // sažeti izvještaj
  recommendations String? // preporuke

  // Dokumentacija
  reportUrl String? // link do pisanog izvještaja (ako postoji)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings AuditFinding[]

  @@index([auditId])
  @@index([scheduledDate])
  @@index([status])
  @@index([leadAuditor])
  @@index([auditType])
}

// AuditFinding — nalazi audita
model AuditFinding {
  id        String @id @default(cuid())
  findingId String @unique // npr. "FIN-2026-001"
  auditId   String // veza na Audit
  audit     Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Tip i klasifikacija
  classification String // MAJOR | MINOR | OBSERVATION | POSITIVE
  category       String // DOCUMENTATION | PROCESS | TRAINING | EQUIPMENT | SAFETY | COMPLIANCE | RECORDS | OTHER
  findingType    String // CONFORMITY | EFFECTIVENESS | OPPORTUNITY_FOR_IMPROVEMENT

  // Sadržaj
  title       String // kratak naslov nalaza
  description String // detaljan opis
  criteria    String? // kriterijum protiv kojeg je utvrđen nalaz (npr. "Part-145.A.40")
  evidence    String? // dokazi (interview, dokument, posmatranje)

  // Lokacija
  area    String? // oblast (npr. "Maintenance log review")
  process String? // proces (npr. "Daily inspection")

  // CAPA
  rootCause        String? // korijenski uzrok (5-why analiza)
  immediateAction  String? // hitna mjera (corrective)
  preventiveAction String? // preventivna mjera
  correctiveAction String? // korektivna mjera

  // Status
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | CORRECTED | VERIFIED | CLOSED | DEFERRED
  assignedTo         String? // ko je zadužen
  dueDate            DateTime?
  closedAt           DateTime?
  closedBy           String?
  verificationResult String? // kako je verifikovano
  verifiedBy         String?
  verifiedAt         DateTime?

  // Risk
  riskLevel String? // LOW | MEDIUM | HIGH | CRITICAL

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([auditId])
  @@index([classification])
  @@index([status])
  @@index([category])
  @@index([dueDate])
}

// CAPA — Corrective and Preventive Action (može biti vezano za finding ili samostalno)
model CAPA {
  id          String @id @default(cuid())
  capaId      String @unique // npr. "CAPA-2026-001"
  title       String
  description String

  // Tip
  type      String // CORRECTIVE | PREVENTIVE | CORRECTIVE_AND_PREVENTIVE
  source    String // AUDIT_FINDING | INCIDENT | HAZARD | SMS | MANAGEMENT_REVIEW | EXTERNAL_AUDIT | CUSTOMER_COMPLAINT | OTHER
  sourceRef String? // referenca (npr. FIN-2026-001, HZ-2026-001)

  // Veza na AuditFinding (ako proizilazi iz audita)
  findingId String?

  // Problem analiza
  problemStatement  String // opis problema
  rootCauseAnalysis String? // 5-why, fishbone analiza
  rootCause         String? // identifikovani korijenski uzrok

  // Akcije
  correctiveAction String? // korektivna akcija
  preventiveAction String? // preventivna akcija
  actionPlan       String? // detaljan plan implementacije

  // Realizacija
  assignedTo       String // odgovorna osoba
  assignedToCardId String?
  dueDate          DateTime
  completedAt      DateTime?

  // Verifikacija
  status                 String    @default("OPEN") // OPEN | IN_PROGRESS | IMPLEMENTED | VERIFIED | CLOSED | OVERDUE
  implementationEvidence String? // dokazi implementacije
  verificationMethod     String? // metoda verifikacije
  verificationResult     String? // rezultat verifikacije (EFFECTIVE | NOT_EFFECTIVE | PARTIAL)
  verifiedBy             String?
  verifiedAt             DateTime?

  // Trošak
  estimatedCost Float?
  actualCost    Float?

  // Napomene
  progressNotes String?
  closureNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([capaId])
  @@index([status])
  @@index([type])
  @@index([source])
  @@index([dueDate])
  @@index([assignedTo])
}

// ComplianceItem — Compliance Matrix (EASA Reg → interni dokument → dokaz)
model ComplianceItem {
  id     String @id @default(cuid())
  itemId String @unique // npr. "CM-001"

  // Regulativa
  regulation      String // npr. "EASA Part-145.A.30"
  requirement     String // tekst zahtjeva (kratak)
  requirementText String? // pun tekst zahtjeva
  category        String // PERSONNEL | FACILITIES | EQUIPMENT | DOCUMENTATION | MAINTENANCE | SMS | OTHER

  // Interni dokumenti
  internalDoc String? // referenca internog dokumenta (npr. "MOM-001", "OPS-MAN-2.3")
  docLocation String? // gdje se nalazi dokument (folder, link)
  docVersion  String? // verzija dokumenta
  docOwner    String? // vlasnik dokumenta

  // Dokaz sukladnosti
  evidenceType        String? // DOCUMENT | RECORD | INTERVIEW | OBSERVATION | TEST
  evidenceRef         String? // referenca na dokaz (npr. "Audit AUD-2026-001")
  evidenceDescription String?
  lastVerified        DateTime?
  verifiedBy          String?

  // Status
  status           String  @default("COMPLIANT") // COMPLIANT | NON_COMPLIANT | PARTIAL | NOT_APPLICABLE | PENDING_REVIEW
  riskLevel        String? // LOW | MEDIUM | HIGH
  gapDescription   String? // ako nije compliant — opis gap-a
  correctiveAction String? // planirana korekcija

  // Review
  nextReviewDate  DateTime? // kada treba ponovo pregledati
  reviewFrequency String? // ANNUAL | BIENNIAL | QUARTERLY

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([regulation])
  @@index([status])
  @@index([category])
}

// ============================================================================
// DOCUMENT CONTROL SYSTEM (EASA Part-145.A.65 + ISO 9001)
// ============================================================================

// Controlled Document — master document register
model ControlledDocument {
  id          String  @id @default(cuid())
  docId       String  @unique // npr. "MOM-001", "OPS-MAN-2.3"
  title       String
  description String?

  // Kategorizacija
  category String // MANUAL | PROCEDURE | WORK_INSTRUCTION | FORM | RECORD | POLICY | PLAN | OTHER
  docType  String // OPERATIONS | MAINTENANCE | SAFETY | QUALITY | TRAINING | ADMINISTRATIVE | TECHNICAL
  standard String? // npr. "EASA Part-145", "ICAO Annex 19", "ISO 9001"

  // Trenutna verzija
  currentVersion String    @default("1.0")
  status         String    @default("DRAFT") // DRAFT | UNDER_REVIEW | APPROVED | PUBLISHED | SUPERSEDED | WITHDRAWN
  effectiveDate  DateTime?
  nextReviewDate DateTime? // obavezno za published

  // Vlasništvo i odgovornosti
  owner       String // document owner (Process Owner)
  ownerCardId String?
  author      String? // ko je napisao
  approver    String? // ko je odobrio

  // Lokacija i pristup
  fileUrl    String? // link do fajla (Google Drive, SharePoint, lokalno)
  fileFormat String? // PDF, DOCX, XLSX
  fileSize   Int? // u bajtima
  location   String? // fizička lokacija (npr. "Server /Documents/MOM/")

  // Review ciklus
  reviewFrequency String    @default("ANNUAL") // ANNUAL | BIENNIAL | QUARTERLY | ON_CHANGE | AD_HOC
  lastReviewedAt  DateTime?
  lastReviewedBy  String?

  // Distribucija
  distributionList String? // JSON array of recipients (može biti i posebna tabela)

  // Sigurnosna klasifikacija
  classification String @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED

  // Napomene
  keywords String? // za pretragu
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions      DocumentVersion[]
  reviews       DocumentReview[]
  distributions DocumentDistribution[]

  @@index([docId])
  @@index([category])
  @@index([status])
  @@index([owner])
  @@index([nextReviewDate])
}

// Document Version — istorija verzija
model DocumentVersion {
  id         String             @id @default(cuid())
  documentId String // veza na ControlledDocument
  document   ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber String // npr. "1.0", "1.1", "2.0"
  revisionDate  DateTime @default(now())

  // Autor i approver
  revisedBy       String
  revisedByCardId String?
  approvedBy      String?
  approvedAt      DateTime?

  // Sadržaj
  changeDescription String // šta je promijenjeno
  changeReason      String? // zašto je promijenjeno
  affectedSections  String? // koje sekcije su pogođene

  // Status
  status        String    @default("DRAFT") // DRAFT | UNDER_REVIEW | APPROVED | PUBLISHED | SUPERSEDED
  effectiveDate DateTime?

  // Fajl
  fileUrl  String?
  fileSize Int?

  // Napomene
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([versionNumber])
  @@index([revisionDate])
  @@index([status])
}

// Document Review — pregledi i revizije
model DocumentReview {
  id         String             @id @default(cuid())
  documentId String // veza na ControlledDocument
  document   ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  reviewType     String // SCHEDULED | AD_HOC | CHANGE_REQUEST | INCIDENT_DRIVEN
  reviewDate     DateTime @default(now())
  reviewer       String
  reviewerCardId String?

  // Rezultat
  result          String // NO_CHANGE_NEEDED | MINOR_UPDATE | MAJOR_REVISION | WITHDRAW | SUPERSEDE
  reviewComments  String? // komentari reviewera
  changesRequired String? // šta treba promijeniti

  // Akcija
  newVersionRequired Boolean   @default(false)
  actionTaken        String?
  completedAt        DateTime?

  // Status
  status String @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([reviewDate])
  @@index([result])
  @@index([status])
}

// Document Distribution — ko je dobio dokument
model DocumentDistribution {
  id         String             @id @default(cuid())
  documentId String // veza na ControlledDocument
  document   ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Primaoc
  recipientName       String // ime primaoca
  recipientRole       String? // funkcija (npr. "Maintenance Manager")
  recipientDepartment String? // odjel (Maintenance, Ramp, Safety, ...)
  recipientEmail      String?

  // Distribucija
  distributionDate   DateTime @default(now())
  distributionMethod String // EMAIL | HARD_COPY | PORTAL | TRAINING | OTHER
  distributedBy      String

  // Primopredaja
  acknowledged       Boolean   @default(false)
  acknowledgedAt     DateTime?
  acknowledgedMethod String? // SIGNATURE | EMAIL_REPLY | SYSTEM_CONFIRM

  // Status
  status String @default("DISTRIBUTED") // DISTRIBUTED | ACKNOWLEDGED | RETURNED | SUPERSEDED

  // Verzija koja je distribuirana
  versionNumber String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([recipientName])
  @@index([recipientDepartment])
  @@index([status])
  @@index([distributionDate])
}
